{
  "name": "nodejs-book-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/main.mjs",
    "worker": "node src/worker.mjs",
    "migrate": "node src/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p typescript/tsconfig.json",
    "test:integration": "node --test integration/*.test.mjs"
  },
  "dependencies": {
    "bullmq": "5.81.5",
    "express": "5.3.0",
    "pg": "8.23.1",
    "redis": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
